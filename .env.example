# ============ 必填 ============
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-byte-hex-secret-here
POSTGRES_USER=tea_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=tea_ceremony

# PostgreSQL 连接串 (docker-compose 内部网络用 db:5432)
DATABASE_URL=postgresql://tea_user:change-this-password@db:5432/tea_ceremony

# 前端调用的后端地址（生产环境使用 Nginx 代理的 /api，开发环境使用 http://localhost:8000/api）
VITE_API_URL=/api

# ============ 可选 ============
# 开发模式：true 时后端挂了不报错、前端用 localStorage 兜底
DEV_MODE=false

# CORS 允许的前端源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 生产安全 ============
# API 限流：每 IP 每窗口最大请求数 / 窗口秒数（内存滑动窗口）
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60

# AI 代理：浏览器不直连第三方 LLM，统一经后端转发
# 默认走 OpenRouter 免费模型路由（openrouter/free），注册 https://openrouter.ai 获取 key
# 免费模型每天约 50 次调用，无需绑卡；未配置 key 时前端降级到规则引擎
AI_PROXY_URL=https://openrouter.ai/api/v1/chat/completions
AI_PROXY_MODEL=openrouter/free
# 在 openrouter.ai -> Keys 创建，形如 sk-or-v1-xxx
AI_PROXY_KEY=
AI_PROXY_TIMEOUT=15

# 后端端口
PORT=8000
