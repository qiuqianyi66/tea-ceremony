# ============ 必填 ============
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-byte-hex-secret-here
POSTGRES_USER=tea_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=tea_ceremony

# PostgreSQL 连接串 (docker-compose 内部网络用 db:5432)
DATABASE_URL=postgresql://tea_user:change-this-password@db:5432/tea_ceremony

# 前端调用的后端地址（生产环境使用 Nginx 代理的 /api，开发环境使用 http://localhost:8000/api）
VITE_API_URL=/api

# ============ 可选 ============
# 开发模式：true 时后端挂了不报错、前端用 localStorage 兜底
DEV_MODE=false

# CORS 允许的前端源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 生产安全 ============
# API 限流：每 IP 每窗口最大请求数 / 窗口秒数（滑动窗口）
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60
# 分布式限流：配置后多实例共享计数（Redis 不可用时自动降级单实例内存限流）；不配置则单实例进程内存限流
REDIS_URL=redis://localhost:6379/0

# Sentry 错误追踪：填入 DSN 后启用（https://sentry.io 项目 Settings -> Client Keys 获取）
# 请求体不会上传（登录接口含密码），异常栈与请求元信息会上报
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# AI 代理：浏览器不直连第三方 LLM，统一经后端转发（DeepSeek 官方 API，OpenAI 兼容）
# 在 https://platform.deepseek.com 申请 key 后填入 AI_PROXY_KEY
# 模型：deepseek-flash（官方默认；旧名 deepseek-v4-flash 已退役由 V4.1-Flash 服务）
# 未配置 key 时后端返回 401/502，前端自动降级到规则引擎
AI_PROXY_URL=https://api.deepseek.com/chat/completions
AI_PROXY_MODEL=deepseek-flash
# 在 https://platform.deepseek.com/api_keys 创建，形如 sk-xxx
AI_PROXY_KEY=
AI_PROXY_TIMEOUT=30

# 后端端口
PORT=8000
