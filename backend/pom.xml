<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.tea</groupId>
    <artifactId>tea-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>tea-backend</name>
    <description>一盏茶 Spring Boot 后端（M1 骨架；旧 FastAPI 仅维护不新增）</description>

    <properties>
        <java.version>21</java.version>
        <!-- M5-S1 统一：agent-framework 与 dashscope 同为 1.1.2.4-security-fix（消 1.1.2.0/1.1.2.4 混用冲突风险，S1 需求 F-S1-1） -->
        <spring-ai-alibaba.version>1.1.2.4-security-fix</spring-ai-alibaba.version>
        <!-- T11 迭代核实：DashScope starter 1.1.2.4-security-fix（旧 spring-ai-alibaba-starter 已停更于 1.0.0-M6.1） -->
        <spring-ai-dashscope.version>1.1.2.4-security-fix</spring-ai-dashscope.version>
        <!-- Testcontainers ≥1.21.4：Docker Engine v29 将最低 API 版本提至 1.44，1.21.2 的 docker-java 协商旧版本被 400 拒绝（npipe 空 /info） -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 持久化：JPA + Flyway + PostgreSQL（红线 #7：禁 ddl-auto: update，ddl-auto=validate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 认证（批 B 启用 Security 配置，先引入依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT（jjwt 0.12.6，T6 认证切片） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Lombok（构造器注入 @RequiredArgsConstructor / @Getter，规范 §1） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- AI 多智能体（PRD 锁定版本；M1.1 仅引入锁定，AI 切片实现） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- DashScope 模型实现（T11 AI 切片；1.1.2.4-security-fix 最新安全修复；提供 ChatModel/ChatClient 自动装配） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>${spring-ai-dashscope.version}</version>
        </dependency>

        <!-- 测试：单元 + 集成（Testcontainers Postgres） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构约束机械化（Harness 285"约束必须自动化"）：分层单向依赖 / 禁 Controller 查库 / 禁字段注入，规则见 .harness/rules/编码规范.md 红线 #1 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
