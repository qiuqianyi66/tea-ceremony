    "description": "一盏茶 service 骨架：纯函数、显式返回类型、@/ 别名导入类型、空输入抛错",
    "body": [
      "/**",
      " * ${1:xxx} 服务：${2:一句话说明}",
      " * 纯函数，无 DOM / 无全局状态，便于单测。",
      " */",
      "import type { ${3:TastingRecord} } from '@/types/${4:tasting}'",
      "",
      "/**",
      " * ${5:一句话说明这个纯函数做什么}",
      " * @param record 输入记录",
      " * @returns ${6:返回值含义}",
      " */",
      "export function ${7:computeXxx}(record: ${3:TastingRecord}): number {",
      "  if (!record) {",
      "    throw new Error('${8:输入记录为空}')",
      "  }",
      "  const values = Object.values(record).filter((v): v is number => typeof v === 'number')",
      "  const total = values.reduce((sum, v) => sum + v, 0)",
      "  return values.length === 0 ? 0 : Math.round((total / values.length) * 10) / 10",
      "}"
    ]
