  "Vue 五态按钮（hover/disabled/loading/error/empty）": {
    "scope": "vue",
    "prefix": "tea-vue-ui",
    "description": "一盏茶五态按钮：inert 合并 disabled+loading，aria-busy/aria-invalid，触控 ≥44px",
    "body": [
      "<script setup lang=\"ts\">",
      "/**",
      " * ${1:动作按钮} — 五态齐全：hover / disabled / loading / error / empty",
      " */",
      "import { computed } from 'vue'",
      "",
      "const props = withDefaults(",
      "  defineProps<{",
      "    disabled?: boolean",
      "    loading?: boolean",
      "    invalid?: boolean",
      "    label?: string",
      "  }>(),",
      "  { disabled: false, loading: false, invalid: false, label: '${2:确认}' },",
      ")",
      "",
      "const emit = defineEmits<{ click: [event: MouseEvent] }>()",
      "",
      "const inert = computed(() => props.disabled || props.loading)",
      "",
      "function onClick(event: MouseEvent): void {",
      "  if (inert.value) {",
      "    event.preventDefault()",
      "    return",
      "  }",
      "  emit('click', event)",
      "}",
      "</script>",
      "",
      "<template>",
      "  <button",
      "    type=\"button\"",
      "    :disabled=\"inert\"",
      "    :aria-busy=\"loading || undefined\"",
      "    :aria-invalid=\"invalid || undefined\"",
      "    class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-[var(--color-wood)] px-4 text-sm text-[var(--color-cream)] transition-colors duration-150 hover:bg-[var(--color-ink)] disabled:cursor-not-allowed disabled:opacity-50\"",
      "    :class=\"invalid ? 'ring-2 ring-[var(--color-cinnabar)]' : ''\"",
      "    @click=\"onClick\"",
      "  >",
      "    <span",
      "      v-if=\"loading\"",
      "      class=\"h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent\"",
      "      aria-hidden=\"true\"",
      "    />",
      "    <IconCheck v-else class=\"h-4 w-4\" aria-hidden=\"true\" />",
      "    {{ label }}",
      "  </button>",
      "</template>"
    ]
  },
  "Composable 骨架（ref/computed + onUnmounted 清理）": {
    "scope": "typescript",
    "prefix": "tea-composable",
    "description": "一盏茶 composable 骨架：ref/computed 组合、副作用在 onUnmounted 清理、返回对象",
    "body": [
      "import { computed, onUnmounted, ref } from 'vue'",
      "",
      "/**",
      " * ${1:useXxx}：${2:一句话说明它封装什么}",
      " */",
      "export function ${1:useXxx}(${3:initial}: number = 0) {",
      "  const ${4:value} = ref(${3:initial})",
      "  const ${5:doubled} = computed(() => ${4:value}.value * 2)",
      "",
      "  let timer: ReturnType<typeof setInterval> | null = null",
      "",
      "  function start(): void {",
      "    stop()",
      "    timer = setInterval(() => {",
      "      ${4:value}.value += 1",
      "    }, 1000)",
      "  }",
      "",
      "  function stop(): void {",
      "    if (timer !== null) {",
      "      clearInterval(timer)",
      "      timer = null",
      "    }",
      "  }",
      "",
      "  onUnmounted(stop)",
      "",
      "  return { ${4:value}, ${5:doubled}, start, stop }",
      "}"
    ]
  },
