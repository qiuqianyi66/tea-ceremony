    "description": "一盏茶 Pinia store：defineStore setup 语法，state/getters/actions 分区并全部返回",
    "body": [
      "import { defineStore } from 'pinia'",
      "import { computed, ref } from 'vue'",
      "",
      "import { ${6:fetchXxx} } from '@/services/${2:xxx}'",
      "",
