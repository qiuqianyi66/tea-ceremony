  "ECharts 初始化 + resize + dispose": {
    "scope": "vue",
    "prefix": "tea-echarts",
    "description": "一盏茶 ECharts 组件：按需注册模块、echarts.init、resize 监听、onUnmounted dispose",
    "body": [
      "<script setup lang=\"ts\">",
      "/**",
      " * ${1:图表组件}：ECharts 初始化 + resize 监听 + 卸载 dispose",
      " */",
      "import type { ECharts, EChartsOption } from 'echarts'",
      "import { BarChart } from 'echarts/charts'",
      "import { GridComponent, TooltipComponent } from 'echarts/components'",
      "import * as echarts from 'echarts/core'",
      "import { CanvasRenderer } from 'echarts/renderers'",
      "import { onMounted, onUnmounted, ref, shallowRef } from 'vue'",
      "",
      "import { colorTokens } from '@/styles/colorTokens'",
      "",
      "echarts.use([BarChart, GridComponent, TooltipComponent, CanvasRenderer])",
      "",
      "const chartEl = ref<HTMLDivElement | null>(null)",
      "const chart = shallowRef<ECharts | null>(null)",
      "",
      "function resize(): void {",
      "  chart.value?.resize()",
      "}",
      "",
      "onMounted(() => {",
      "  if (!chartEl.value) return",
      "  const instance = echarts.init(chartEl.value)",
      "  chart.value = instance",
      "  const option: EChartsOption = {",
      "    backgroundColor: 'transparent',",
      "    tooltip: { trigger: 'axis' },",
      "    xAxis: { type: 'category', data: ['${2:绿茶}', '${3:乌龙茶}'] },",
      "    yAxis: { type: 'value' },",
      "    series: [",
      "      {",
      "        type: 'bar',",
      "        data: [${4:3}, ${5:5}],",
      "        itemStyle: { color: colorTokens.teaGold },",
      "      },",
      "    ],",
      "  }",
      "  instance.setOption(option)",
      "  window.addEventListener('resize', resize)",
      "})",
      "",
      "onUnmounted(() => {",
      "  window.removeEventListener('resize', resize)",
      "  chart.value?.dispose()",
      "  chart.value = null",
      "})",
      "</script>",
      "",
      "<template>",
      "  <div ref=\"chartEl\" class=\"h-64 w-full rounded-xl bg-[var(--color-paper)]\" />",
      "</template>"
    ]
  }
