      "  // state",
      "  const ${3:items} = ref<${4:string}[]>([])",
      "  const ${5:loading} = ref(false)",
      "",
      "  // getters",
      "  const ${7:count} = computed(() => ${3:items}.value.length)",
      "",
      "  // actions",
      "  function ${8:add}(item: ${4:string}): void {",
      "    ${3:items}.value.push(item)",
      "  }",
      "",
      "  async function ${9:load}(): Promise<void> {",
      "    ${5:loading}.value = true",
      "    try {",
      "      ${3:items}.value = await ${6:fetchXxx}()",
      "    } catch (err) {",
      "      console.error('[${2:xxx}Store] 加载失败', err)",
      "    } finally {",
      "      ${5:loading}.value = false",
      "    }",
      "  }",
      "",
      "  return { ${3:items}, ${5:loading}, ${7:count}, ${8:add}, ${9:load} }",
      "})"
    ]
  },
