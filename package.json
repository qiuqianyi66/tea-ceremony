{
  "name": "tea-ceremony",
  "version": "1.0.0",
  "private": true,
  "description": "沉浸式在线茶道体验：选茶、备器、冲泡与品鉴记录",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check src e2e scripts",
    "lint:fix": "biome check --write src e2e scripts",
    "verify": "npm run verify:static && npm run audit:context",
    "verify:static": "node scripts/scan-emoji.cjs",
    "audit:context": "node scripts/audit-context-budget.cjs",
    "verify:ui": "node scripts/verify-gardens.cjs && node scripts/verify-pavilion.cjs && node scripts/verify-icons.cjs",
    "quality": "npm run lint && npm run type-check && npm run test && npm run build && npm run verify",
    "quality:full": "npm run quality && npm audit --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@tresjs/cientos": "^5.9.3",
    "@tresjs/core": "^5.9.3",
    "@tsparticles/preset-bubbles": "^4.3.2",
    "@tsparticles/preset-fire": "^4.3.2",
    "@tsparticles/slim": "^4.4.0",
    "@tsparticles/vue3": "^4.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.5",
    "echarts": "^6.1.0",
    "howler": "^2.2.4",
    "js-yaml": "^5.4.3",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "three": "^0.186.0",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "npm-run-all2": "^9.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "vite": "^8.1.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
